# ============================================================================
# CarePoint Hospital Management System (HMS) - Backend Environment Configuration
# ============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase Project Configuration
# Replace these with your actual Supabase project credentials from Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Storage Bucket Names
SUPABASE_STORAGE_AVATARS=avatars
SUPABASE_STORAGE_REPORTS=lab-reports
SUPABASE_STORAGE_DOCUMENTS=patient-documents
